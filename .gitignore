# Build outputs and local working artifacts
# Go: sources only are tracked. `go build -C supplement -o bin/ ./cmd/...` writes to
# supplement/bin/; a bare `go build` inside a command directory writes a binary named
# after the directory; the proof runner builds into runs/<mode>-*/bin.
# `/supplement/cmd/*/*` with its `.go` exception also ignores any other non-.go file
# under supplement/cmd/<name>/ (there are none); add a negation if testdata is needed.
/supplement/bin/
/supplement/cmd/*/*
!/supplement/cmd/*/*.go
/supplement/*.test
/supplement/**/*.test
/supplement/**/*.out
# The tools module (go build -C tools -o bin/ ./cmd/...) is treated the same way;
# research-checks writes its scratch tree under tmp/, which is ignored below.
/tools/bin/
/tools/cmd/*/*
!/tools/cmd/*/*.go
/tools/*.test
/tools/**/*.test
/tools/**/*.out
.DS_Store
*.log
/tmp/
**/reproduction-logs/
/research/en_independent/e*-fc.json
/supplement/dist/
/output/supplement/
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz

# Third-party sources (downloaded papers, theses, software) stay local;
# citations and audits retain their URLs. Only the project's own PDF
# builds under output/pdf/ are tracked.
/sources/
*.pdf
*.png
*.html
!/output/pdf/exceptional-leading.pdf
/research/en_literature/green*.txt
/research/en_literature/kashiwara-tanisaki*.txt
/research/en_literature/stembridge-fc.txt
/research/en_literature/lusztig-unequal.txt
/research/en_uniform/stembridge-countFC.txt
/research/en_uniform/hagiwara-ishikawa-tagawa-fpsac2004.txt
/research/exceptional_priority/geck-pycox.txt
/research/exceptional_priority/geck-halls.txt
/research/exceptional_priority/mongelli-2011.txt
/research/exceptional_priority/garfinkle-vogan.txt
/research/ai-review-notes/priority-sources/*
!/research/ai-review-notes/priority-sources/pycox-data-inspection.json
!/research/ai-review-notes/priority-sources/pycox-commit.json
